# --- Model gateway (OpenAI-compatible) ---------------------------------------
ASSAY_GATEWAY_URL=https://model-gateway.internal.example/v1
ASSAY_GATEWAY_KEY=                      # inject from the secrets manager; never commit
ASSAY_GATEWAY_HEADERS={}                # extra headers your gateway needs, as JSON
ASSAY_MODEL=                            # default model for every role
# ASSAY_MODEL_PRD=                      # optional per-role overrides: GRILL, EXPLORE,
# ASSAY_MODEL_SPEC=                     # QUESTIONNAIRE, RECONCILE, DOD, PRD, SPEC, TICKETS
# ASSAY_MODEL_TICKETS=
ASSAY_TIMEOUT_S=120

# --- Prompt caching -----------------------------------------------------------
# explicit: add cache markers (models that need them, e.g. Anthropic via the gateway)
# auto:     no markers; rely on automatic prefix caching (e.g. OpenAI-family models)
# off:      no caching hints
ASSAY_CACHE_MODE=explicit

# --- Retry with backoff (transient gateway errors only) -----------------------
ASSAY_RETRY_ATTEMPTS=5
ASSAY_RETRY_BASE_S=1.0
ASSAY_RETRY_CAP_S=30

# --- Limits per agent call ------------------------------------------------------
ASSAY_MAX_STEPS=40
ASSAY_MAX_OUTPUT_RETRIES=3

# --- Persistence ------------------------------------------------------------------
ASSAY_DATABASE_URL=postgresql://assay@db.internal.example:5432/assay
ASSAY_ARTIFACTS_DIR=/srv/assay/data

# --- Identity and roles -------------------------------------------------------------
ASSAY_USER_HEADER=X-Forwarded-User      # set by the SSO proxy in front of the app
ASSAY_APPROVERS=dana.ortiz,lee.chen     # who may approve a PRD; empty = anyone (do not leave empty in production)
# ASSAY_DEV_USER=jordan                 # development only: user when no SSO header is present

# --- Code access (mode 2 and spec) ---------------------------------------------------
ASSAY_CODE_ROOTS=/srv/repos/payments:/srv/repos/alerts   # the only directories agents may read

# --- Branding ----------------------------------------------------------------------------
ASSAY_TEAM_NAME=Cards team
# ASSAY_LOGO_PATH=/srv/assay/brand/logo.png              # approved logo for the PRD PDF
